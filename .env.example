# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SMART PRICE MONITOR
# ==============================================================================
# Copie este arquivo para .env na sua VPS:
#   cp .env.example .env
# Em seguida, configure as credenciais do seu MySQL existente:
#   nano .env
# E inicie o container:
#   docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (MySQL nativo da sua VPS)
# ------------------------------------------------------------------------------
# host.docker.internal conecta diretamente no MySQL rodando na sua VPS Linux
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=smart_price_telegram
DB_USERNAME=root
DB_PASSWORD=sua_senha_do_mysql_da_vps

# (Opcional: Caso queira sobrescrever a URL JDBC inteira)
# DB_URL=jdbc:mysql://host.docker.internal:3306/smart_price_telegram?useSSL=false&serverTimezone=America/Sao_Paulo&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# ------------------------------------------------------------------------------
# 2. APLICAÇÃO SPRING BOOT
# ------------------------------------------------------------------------------
APP_PORT=8080

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT
# ------------------------------------------------------------------------------
# Token obtido com o @BotFather no Telegram (ex: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=seu_token_do_telegram_aqui
# Chat ID ou username do canal/grupo (ex: @seu_canal ou -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=@seu_canal_de_ofertas
TELEGRAM_BOT_ENABLED=true

# ------------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL (Google Gemini)
# ------------------------------------------------------------------------------
# Chave da API obtida no Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_api_aqui
IA_GEMINI_MODEL=gemini-3.6-flash
IA_GEMINI_ENABLED=true

# ------------------------------------------------------------------------------
# 5. MERCADO LIVRE (API & Parâmetros de Afiliado)
# ------------------------------------------------------------------------------
# Credenciais da sua aplicação do Mercado Livre Developers
ML_CLIENT_ID=seu_ml_client_id_aqui
ML_CLIENT_SECRET=seu_ml_client_secret_aqui
MERCADO_LIVRE_ACCESS_TOKEN=
ML_PROVEDOR_ENABLED=true

# Tags de Afiliado Mercado Livre
ML_MATT_TOOL=seu_matt_tool_aqui
ML_MATT_WORD=seu_matt_word_aqui
ML_FORCE_IN_APP=true
ML_AFILIADO_TAG=matt_tool=seu_matt_tool_aqui&matt_word=seu_matt_word_aqui&forceInApp=true

# ------------------------------------------------------------------------------
# 6. MODO NOTURNO (Silenciamento / Pausa de Madrugada)
# ------------------------------------------------------------------------------
MODO_NOTURNO_ENABLED=true
MODO_NOTURNO_INICIO=23:00
MODO_NOTURNO_FIM=07:30
MODO_NOTURNO_FUSO=America/Sao_Paulo
MODO_NOTURNO_PAUSAR=true

# ------------------------------------------------------------------------------
# 7. CRAWLER & VALIDADOR DE CUPONS
# ------------------------------------------------------------------------------
CUPONS_CRAWLER_ENABLED=true
CUPONS_MONITOR_ENABLED=true
CUPONS_VALIDADOR_ENABLED=true
